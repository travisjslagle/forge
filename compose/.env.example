# Forge compose settings
TZ=America/Indianapolis
FORGE_ROOT=/opt/forge
FORGE_BUDGET_SOURCE=/home/forge/forge-budget
FORGE_BUDGET_DATA=/srv/forge-data/budget
FORGE_LAN_IP=192.168.50.220
FORGE_LAN_SUBNET=192.168.50.0/24
PUID=1000
PGID=1000

# Homepage must know which hosts are allowed to render it.
# Add the reserved LAN IP once known.
HOMEPAGE_ALLOWED_HOSTS=forge.local,forge,localhost,127.0.0.1,192.168.50.220,192.168.50.220:3000
